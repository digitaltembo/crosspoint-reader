{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "fonts.json",
  "description": "SD font download manifest, generated by scripts/generate-font-manifest.py and fetched over HTTP by FontDownloadActivity (src/activities/settings/FontDownloadActivity.cpp). Not stored on the SD card.",
  "type": "object",
  "properties": {
    "version": {
      "description": "Manifest schema version; the device rejects anything other than FONTS_MANIFEST_VERSION.",
      "const": 1
    },
    "baseUrl": {
      "description": "URL prefix that each file name is appended to for download; ends with '/'.",
      "type": "string"
    },
    "scriptGroups": {
      "description": "Script filters shown on the device, in display order. Only groups used by at least one family are listed; entries past 32 are ignored.",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "tag": {
            "description": "Identifier referenced by families[].scripts.",
            "type": "string"
          },
          "label": {
            "description": "English display label.",
            "type": "string"
          }
        },
        "required": ["tag", "label"]
      }
    },
    "families": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "description": "Family name; also the SD font folder name and the value stored in settings.json sdFontFamilyName.",
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "styles": {
            "description": "Styles present in the family's .cpfont files. Not read by the device.",
            "type": "array",
            "items": {
              "type": "string",
              "enum": ["regular", "bold", "italic", "bolditalic"]
            }
          },
          "scripts": {
            "description": "scriptGroups tags this family covers.",
            "type": "array",
            "items": { "type": "string" }
          },
          "files": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "description": ".cpfont file name, relative to baseUrl.",
                  "type": "string"
                },
                "size": {
                  "description": "File size in bytes.",
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 4294967295
                },
                "crc32": {
                  "description": "CRC-32 (zlib/IEEE) of the file contents; a download that does not match is discarded.",
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 4294967295
                }
              },
              "required": ["name", "size", "crc32"]
            }
          }
        },
        "required": ["name", "description", "scripts", "files"]
      }
    }
  },
  "required": ["version", "baseUrl", "scriptGroups", "families"]
}
